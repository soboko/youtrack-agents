# YouTrack access for the agent tooling. Copy to .env.youtrack (git-ignored) at the root of the checkout that uses
# it, or to ~/.config/youtrack-agents/env for worktrees and checkouts that do not carry their own, or point
# YOUTRACK_ENV_FILE at it. The token is a YouTrack permanent token (Profile > Account Security > Tokens).
YOUTRACK_URL=https://example.youtrack.cloud
YOUTRACK_PROJECT=PRJ
YOUTRACK_TOKEN=perm-...
# Optional
YOUTRACK_BOARD=Kanban Board            # the main kanban board's name; default: the first board the token sees
YOUTRACK_SPRINT_BOARD=Kanban Board     # the board sprint commands default to; default: YOUTRACK_BOARD
YOUTRACK_OWNER=admin                   # login that issues waiting on a person are assigned to
# YOUTRACK_TEAM_GROUP=PRJ Team         # group saved searches are shared with; default: the project's own team
